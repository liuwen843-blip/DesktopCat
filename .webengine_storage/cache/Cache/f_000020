      /* =========================================================
       * 台词选择 / LLM / 降级 / 语音串联
       * ========================================================= */
      function pickFrom(arr) {
        if (!arr || !arr.length) return DEFAULT_LINES[0];
        return arr[Math.floor(Math.random() * arr.length)];
      }

      /** 强降级：专属离线库 → 收藏 → 场景预置 → 默认库 */
      function fallbackLine(pool) {
        try {
          store = loadStore();
          if (store.offlineLines && store.offlineLines.length) {
            return pickFrom(store.offlineLines);
          }
          if (store.favorites && store.favorites.length) {
            return pickFrom(store.favorites);
          }
        } catch (_) {}
        if (pool && pool.length) return pickFrom(pool);
        return pickFrom(DEFAULT_LINES);
      }

      function fetchWithTimeout(url, options, ms) {
        const ctrl = new AbortController();
        const timer = setTimeout(function () { ctrl.abort(); }, ms || LLM_CHAT_TIMEOUT_MS);
        const opts = Object.assign({}, options, { signal: ctrl.signal });
        return fetch(url, opts).finally(function () { clearTimeout(timer); });
      }

      function stripEndpointSlashes(endpoint) {
        return String(endpoint || "").trim().replace(/\/+$/, "");
      }

      /** 折叠误写的 /v1/v1… */
      function collapseDuplicateV1(url) {
        return String(url || "").replace(/\/v1(?:\/v1)+/gi, "/v1");
      }

      /**
       * 归一化为 OpenAI 兼容 chat/completions URL。
       * https://host/v1 → …/v1/chat/completions
       * https://host → …/v1/chat/completions
       * 已是完整路径则原样（去尾斜杠）
       */
      function resolveChatCompletionsUrl(endpoint) {
        let base = collapseDuplicateV1(stripEndpointSlashes(endpoint));
        if (!base) return "";
        if (/\/chat\/completions$/i.test(base)) return base;
        if (/\/models$/i.test(base)) return base.replace(/\/models$/i, "/chat/completions");
        if (/\/v1\/completions$/i.test(base)) {
          return base.replace(/\/completions$/i, "/chat/completions");
        }
        if (/\/v1$/i.test(base)) return base + "/chat/completions";
        return base + "/v1/chat/completions";
      }

      /** 归一化为 OpenAI 兼容 /v1/models */
      function resolveModelsUrl(endpoint) {
        let base = collapseDuplicateV1(stripEndpointSlashes(endpoint));
        if (!base) return "";
        if (/\/models$/i.test(base)) return base;
        if (/\/chat\/completions$/i.test(base)) {
          return base.replace(/\/chat\/completions$/i, "/models");
        }
        if (/\/completions$/i.test(base)) {
          return base.replace(/\/completions$/i, "/models");
        }
        if (/\/v1$/i.test(base)) return base + "/models";
        return base + "/v1/models";
      }

      function llmReady(s) {
        s = s || store;
        return !!(s.llmEnabled && s.apiEndpoint && s.apiKey);
      }

      function apiConfigured(s) {
        s = s || store;
        return !!(s.apiEndpoint && s.apiKey);
      }

      function formatElapsedMs(ms) {
        return Math.max(0, Math.round(ms)) + "ms";
      }

      function logLlmFallback(reason, detail, elapsedMs) {
        try {
          const timing = elapsedMs != null ? (" 耗时=" + formatElapsedMs(elapsedMs)) : "";
          console.warn("[桌宠 LLM] 请求失败，已回退本地词库：" + reason + timing, detail || "");
        } catch (_) {}
      }

      function hasOfflineCorpus(s) {
        s = s || store;
        return !!(s.offlineLines && s.offlineLines.length);
      }

      function shouldUseOfflineFirst(opts) {
        opts = opts || {};
        if (opts.forceOnline) return false;
        store = loadStore();
        return !!(store.preferOfflineCorpus && hasOfflineCorpus(store));
      }

      /**
       * System = 人设/规则/禁令；User = 场景上下文。
       * LLM 开启且已配置时必须先打 API；仅关闭或失败时才兜底。
       * 返回 { line, source: "llm"|"fallback"|"offline", hint? }
       */
      async function resolveLine(userPrompt, fallbackPool, opts) {
        opts = opts || {};
        store = loadStore();

        if (shouldUseOfflineFirst(opts)) {
          return { line: pickFrom(store.offlineLines), source: "offline" };
        }

        if (!store.llmEnabled) {
          return { line: fallbackLine(fallbackPool), source: "fallback", reason: "llm_off" };
        }
        if (!store.apiEndpoint || !store.apiKey) {
          logLlmFallback("missing_config", "已开启实时生成但未填写 Endpoint 或 API Key");
          return {
            line: fallbackLine(fallbackPool),
            source: "fallback",
            hint: "未配置 Endpoint/Key，已用本地兜底"
          };
        }

        const t0 = performance.now();
        try {
          const chatUrl = resolveChatCompletionsUrl(store.apiEndpoint);
          console.log("实际请求地址:", chatUrl);
          const systemContent = buildSystemPromptForLlm(store, userPrompt);
          const userContent = buildLlmUserPrompt(userPrompt);
          console.log(
            "[桌宠 LLM] Prompt 长度 system=" + systemContent.length +
            " user=" + userContent.length +
            " timeout=" + LLM_CHAT_TIMEOUT_MS + "ms"
          );

          const res = await fetchWithTimeout(
            chatUrl,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + store.apiKey
              },
              body: JSON.stringify({
                model: store.modelName || "gpt-4o-mini",
                temperature: 0.85,
                max_tokens: 64,
                messages: [
                  { role: "system", content: systemContent },
                  { role: "user", content: userContent }
                ]
              })
            },
            LLM_CHAT_TIMEOUT_MS
          );

          const elapsed = performance.now() - t0;
          let bodyText = "";
          try {
            bodyText = await res.text();
          } catch (_) {
            bodyText = "";
          }

          if (!res.ok) {
            logLlmFallback("HTTP " + res.status, bodyText.slice(0, 500), elapsed);
            return {
              line: fallbackLine(fallbackPool),
              source: "fallback",
              hint: "API " + res.status + "（" + formatElapsedMs(elapsed) + "），已用本地兜底"
            };
          }

          let data = null;
          try {
            data = bodyText ? JSON.parse(bodyText) : {};
          } catch (parseErr) {
            logLlmFallback("json_parse", bodyText.slice(0, 500), elapsed);
            return {
              line: fallbackLine(fallbackPool),
              source: "fallback",
              hint: "API 返回无法解析（" + formatElapsedMs(elapsed) + "），已用本地兜底"
            };
          }

          const text =
            (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) ||
            data.output_text ||
            data.reply ||
            "";
          const cleaned = String(text).trim().replace(/^["「『]|["」』]$/g, "");
          if (cleaned) {
            console.log("[桌宠 LLM] 成功 耗时=" + formatElapsedMs(elapsed));
            return { line: cleaned.slice(0, 30), source: "llm" };
          }

          logLlmFallback("empty_content", data, elapsed);
          return {
            line: fallbackLine(fallbackPool),
            source: "fallback",
            hint: "API 无有效内容（" + formatElapsedMs(elapsed) + "），已用本地兜底"
          };
        } catch (err) {
          const elapsed = performance.now() - t0;
          const name = err && err.name;
          const msg = err && err.message;
          const isTimeout = name === "AbortError";
          logLlmFallback(isTimeout ? "timeout" : "network", msg || err, elapsed);
          return {
            line: fallbackLine(fallbackPool),
            source: "fallback",
            hint: isTimeout
              ? "API 超时（" + formatElapsedMs(elapsed) + "），已用本地兜底"
              : "网络异常（" + formatElapsedMs(elapsed) + "），已用本地兜底"
          };
        }
      }

      function minimaxConfigured() {
        store = loadStore();
        return !!(store.minimaxKey && store.minimaxGroup && store.minimaxVoice);
      }

      function applyAudioSettings() {
        store = loadStore();
        const vol = Math.max(0, Math.min(100, Number(store.voiceVolume == null ? 80 : store.voiceVolume)));
        const muted = !!store.voiceMuted;
        ttsAudio.muted = muted;
        ttsAudio.volume = muted ? 0 : vol / 100;
        const label = document.getElementById("vol-label");
        if (label) label.textContent = Math.round(vol) + "%";
      }

      /** 打断上一句语音，避免重叠 */
      function stopCurrentTTS() {
        ttsToken += 1;
        try {
          ttsAudio.pause();
          ttsAudio.currentTime = 0;
          ttsAudio.removeAttribute("src");
          ttsAudio.load();
        } catch (_) {}
        if (ttsObjectUrl) {
          try { URL.revokeObjectURL(ttsObjectUrl); } catch (_) {}
          ttsObjectUrl = null;
        }
        stopTalkAnim();
        clearTtsPreviewUi();
      }

      /* ---------- MiniMax T2A 语音 ---------- */
      let ttsToken = 0;
      let ttsObjectUrl = null;

      function clearTtsPreviewUi() {
        try {
          document.querySelectorAll(".btn-tts.playing").forEach(function (el) {
            el.classList.remove("playing");
          });
        } catch (_) {}
      }

      function stopTalkAnim() {
        pet.classList.remove("talking");
        live2dTalking = false;
        setLive2DMouth(0);
        resolveVisualAfterTemp();
      }

      function startTalkAnim() {
        if (state === THROWING) return;
        pet.classList.add("talking");
        live2dTalking = true;
        tryLive2DMotion(["Tap", "tap", "Talk", "Speak", "Idle"]);
        setPetState("speaking", { restart: true });
      }

      function hexToUint8Array(hex) {
        const clean = String(hex).replace(/\s/g, "");
        const len = clean.length;
        const out = new Uint8Array(Math.floor(len / 2));
        for (let i = 0; i < out.length; i++) {
          out[i] = parseInt(clean.substr(i * 2, 2), 16);
        }
        return out;
      }

      async function playMinimaxTTS(text, opts) {
        opts = opts || {};
        const report = !!opts.report;
        const previewBtn = opts.previewBtn || null;
        try {
          stopCurrentTTS();
          const myToken = ttsToken;

          store = loadStore();
          const key = (opts.key != null ? opts.key : store.minimaxKey || "").trim();
          const group = (opts.group != null ? opts.group : store.minimaxGroup || "").trim();
          const voiceId = (opts.voice != null ? opts.voice : store.minimaxVoice || "").trim();
          const forceUnmute = !!opts.forceUnmute;

          if (!text) {
            if (report) return { ok: false, error: "没有可播放的文本" };
            return;
          }
          if (!key || !group || !voiceId) {
            if (report) return { ok: false, error: "请填写 MiniMax Key、Group ID 与 Voice ID" };
            return;
          }
          if (store.voiceMuted && !forceUnmute) {
            if (report) return { ok: false, error: "当前已静音，请关闭静音后再试" };
            return;
          }

          if (previewBtn) previewBtn.classList.add("playing");

          applyAudioSettings();
          if (forceUnmute) {
            ttsAudio.muted = false;
            const vol = Math.max(0, Math.min(100, Number(store.voiceVolume == null ? 80 : store.voiceVolume)));
            ttsAudio.volume = Math.max(0.15, vol / 100);
          }

          const endpoints = [
            "https://api.minimaxi.com/v1/t2a_v2?GroupId=" + encodeURIComponent(group),
            "https://api.minimax.io/v1/t2a_v2"
          ];

          const payload = {
            model: "speech-01-turbo",
            text: String(text).slice(0, 200),
            stream: false,
            voice_setting: {
              voice_id: voiceId,
              speed: 1.05,
              vol: 1,
              pitch: 0
            },
            audio_setting: {
              sample_rate: 32000,
              bitrate: 128000,
              format: "mp3",
              channel: 1
            },
            output_format: "hex"
          };

          let data = null;
          let lastHttp = 0;
          let lastApiMsg = "";
          for (let i = 0; i < endpoints.length; i++) {
            if (myToken !== ttsToken) {
              if (report) return { ok: false, error: "已被新的语音打断" };
              return;
            }
            try {
              const res = await fetchWithTimeout(
                endpoints[i],
                {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + key
                  },
                  body: JSON.stringify(payload)
                },
                12000
              );
              lastHttp = res.status;
              if (!res.ok) continue;
              const json = await res.json();
              const code = json.base_resp && json.base_resp.status_code;
              if (code != null && code !== 0) {
                lastApiMsg = (json.base_resp && json.base_resp.status_msg) || ("错误码 " + code);
                continue;
              }
              data = json;
              break;
            } catch (_) {}
          }
          if (!data || myToken !== ttsToken) {
            clearTtsPreviewUi();
            if (report) {
              if (lastApiMsg) return { ok: false, error: "合成失败：" + lastApiMsg };
              if (lastHttp === 401) return { ok: false, error: "Key 无效（401），请检查 MiniMax API Key" };
              if (lastHttp === 404) return { ok: false, error: "接口不存在（404），请检查网络或地区域名" };
              return { ok: false, error: "发音失败：请检查 Key / Group ID / Voice ID" };
            }
            return;
          }

          const audioHex = data.data && data.data.audio;
          if (!audioHex) {
            clearTtsPreviewUi();
            if (report) return { ok: false, error: "返回无音频数据，请检查 Voice ID" };
            return;
          }

          const bytes = hexToUint8Array(audioHex);
          const blob = new Blob([bytes], { type: "audio/mpeg" });
          if (ttsObjectUrl) {
            try { URL.revokeObjectURL(ttsObjectUrl); } catch (_) {}
          }
          ttsObjectUrl = URL.createObjectURL(blob);
          if (myToken !== ttsToken) {
            if (report) return { ok: false, error: "已被新的语音打断" };
            return;
          }

          applyAudioSettings();
          if (forceUnmute) {
            ttsAudio.muted = false;
            const vol = Math.max(0, Math.min(100, Number(store.voiceVolume == null ? 80 : store.voiceVolume)));
            ttsAudio.volume = Math.max(0.15, vol / 100);
          }
          ttsAudio.src = ttsObjectUrl;

          function syncBubbleToAudio() {
            if (myToken !== ttsToken) return;
            if (isFinite(ttsAudio.duration) && ttsAudio.duration > 0) {
              extendBubbleForAudio(ttsAudio.duration * 1000);
            }
          }
          ttsAudio.addEventListener("loadedmetadata", syncBubbleToAudio, { once: true });
          ttsAudio.addEventListener("durationchange", syncBubbleToAudio, { once: true });

          startTalkAnim();
          try {
            await ttsAudio.play();
            syncBubbleToAudio();
          } catch (_) {
            stopTalkAnim();
            if (report) return { ok: false, error: "浏览器无法播放音频" };
            return;
          }
          if (report) return { ok: true };
        } catch (_) {
          stopTalkAnim();
          if (report) return { ok: false, error: "发音失败：网络或接口异常" };
        }
      }

      ttsAudio.addEventListener("ended", function () {
        stopTalkAnim();
        clearTtsPreviewUi();
      });
      ttsAudio.addEventListener("pause", function () {
        if (ttsAudio.ended || ttsAudio.currentTime === 0) stopTalkAnim();
      });
      ttsAudio.addEventListener("error", function () {
        stopTalkAnim();
        clearTtsPreviewUi();
      });

      let speakBusy = false;

      /** 自动化/互动统一出口：省 Token 离线优先 → LLM 现写 → 失败兜底 → 气泡 → MiniMax */
      async function speak(userPrompt, fallbackPool, opts) {
        if (IS_SETTINGS_WINDOW) return;
        opts = opts || {};
        const allowBusyStates = !!opts.allowBusyStates;
        if (!allowBusyStates && (state === BITING || state === THROWING)) return;
        if (speakBusy && !opts.force) return;
        speakBusy = true;
        try {
          store = loadStore();
          let result = null;
          try {
            result = await resolveLine(userPrompt, fallbackPool, opts);
          } catch (err) {
            logLlmFallback("resolve_throw", err && err.message);
            result = {
              line: fallbackLine(fallbackPool),
              source: "fallback",
              hint: "生成异常，已用本地兜底"
            };
          }
          let line = result && result.line;
          if (!line) line = fallbackLine(fallbackPool);
          if (result && result.source === "fallback" && result.hint && store.llmEnabled) {
            showToast(result.hint, 2400);
          }
          if (!allowBusyStates && (state === BITING || state === THROWING)) return;

          const voiceJob = showBubble(line, {
            favoritable: true,
            duration: opts.duration,
            voice: opts.voice !== false
          });

          /* ✨ 等路径：等到语音开始播放（或配置缺失/静音直接跳过）再结束加载态 */
          if (opts.awaitVoice && voiceJob && typeof voiceJob.then === "function") {
            try {
              await voiceJob;
            } catch (_) { /* 语音失败不阻断气泡 */ }
          }
        } catch (_) {
          try {
            const voiceJob = showBubble(fallbackLine(fallbackPool), {
              favoritable: true,
              voice: true
            });
            if (opts.awaitVoice && voiceJob && typeof voiceJob.then === "function") {
              try { await voiceJob; } catch (__) {}
            }
          } catch (__) { /* 绝对不炸 */ }
        } finally {
          speakBusy = false;
        }
      }

      /* =========================================================
       * 自动化：时长 / 饭点 / 空闲
       * ========================================================= */
      const bootAt = Date.now();
      let lastActivity = Date.now();
      let idleLatched = false;
      const uptimeFiredSession = {};

      function markActivity() {
        lastActivity = Date.now();
        if (idleLatched) {
          idleLatched = false;
          pet.classList.remove("daydream");
        }
      }

      function todayKey() {
        const d = new Date();
        return d.getFullYear() + "-" + (d.getMonth() + 1) + "-" + d.getDate();
      }

      function parseHM(hm) {
        const p = hm.split(":");
        return parseInt(p[0], 10) * 60 + parseInt(p[1], 10);
      }

      function nowMinutes() {
        const d = new Date();
        return d.getHours() * 60 + d.getMinutes();
      }

      async function checkUptime() {
        if (IS_SETTINGS_WINDOW) return;
        const elapsedH = (Date.now() - bootAt) / 3600000;
        for (let i = 0; i < UPTIME_MARKS.length; i++) {
          const m = UPTIME_MARKS[i];
          if (elapsedH >= m.hours && !uptimeFiredSession[m.key]) {
            uptimeFiredSession[m.key] = true;
            await speak(m.userPrompt, m.lines);
            break;
          }
        }
      }

      async function checkMeals() {
        if (IS_SETTINGS_WINDOW) return;
        const day = todayKey();
        const mins = nowMinutes();
        store = loadStore();
        const fired = Object.assign({}, store.mealFired);
        const dayMap = Object.assign({}, fired[day] || {});
        for (let i = 0; i < MEALS.length; i++) {
          const meal = MEALS[i];
          const a = parseHM(meal.start);
          const b = parseHM(meal.end);
          if (mins >= a && mins <= b && !dayMap[meal.key]) {
            dayMap[meal.key] = true;
            fired[day] = dayMap;
            store = saveStore({ mealFired: fired });
            await speak(meal.userPrompt, meal.lines);
            break;
          }
        }
      }

      async function checkIdle() {
        if (IS_SETTINGS_WINDOW) return;
        if (state !== IDLE) return;
        if (Date.now() - lastActivity < IDLE_MS) return;
        if (idleLatched) return;
        idleLatched = true;
        pet.classList.add("daydream");
        await speak(IDLE_USER_PROMPT, IDLE_LINES);
      }

      setInterval(function () {
        checkUptime();
        checkMeals();
        checkIdle();
      }, 30000);
      setInterval(checkMeals, 60000);

      ["mousemove", "mousedown", "click", "keydown", "wheel", "touchstart"].forEach(function (ev) {
        window.addEventListener(ev, markActivity, { passive: true });
      });

      /* =========================================================
       * 设置面板
       * ========================================================= */
      const fields = {
        llm: document.getElementById("opt-llm"),
        offlineFirst: document.getElementById("opt-offline-first"),
        autohide: document.getElementById("opt-autohide"),
        intro: document.getElementById("opt-intro"),
        appAware: document.getElementById("opt-app-aware"),
        typingAware: document.getElementById("opt-typing-aware"),
        modeClassic: document.getElementById("mode-classic"),
        modeGif: document.getElementById("mode-gif"),
        modeLive2d: document.getElementById("mode-live2d"),
        gifIdle: document.getElementById("gif-idle"),
        gifSpeaking: document.getElementById("gif-speaking"),
        gifClicked: document.getElementById("gif-clicked"),
        gifWorking: document.getElementById("gif-working"),
        endpoint: document.getElementById("cfg-endpoint"),
        apikey: document.getElementById("cfg-apikey"),
        model: document.getElementById("cfg-model"),
        modelSelect: document.getElementById("cfg-model-select"),
        mmKey: document.getElementById("cfg-mm-key"),
        mmGroup: document.getElementById("cfg-mm-group"),
        mmVoice: document.getElementById("cfg-mm-voice"),
        mute: document.getElementById("opt-mute"),
        volume: document.getElementById("cfg-volume"),
        bubbleStay: document.getElementById("cfg-bubble-stay"),
        prompt: document.getElementById("cfg-persona"),

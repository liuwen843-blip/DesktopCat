          const systemContent = buildSystemPrompt(store) + "\n\n" + getLocalTimeContext();
          const userContent =
            "请严格根据以上人设、对话规则与思维底色，一次性写出 30 句你平时在电脑屏幕角落发呆、看主人工作、无聊自言自语时会冒出来的日常短句气泡（口语化、≤25字、符合人设且幽默不八股）。" +
            "只返回纯 JSON 字符串数组，不要其它说明，例如：[\"句子1\",\"句子2\"]";
          const res = await fetchWithTimeout(
            chatUrl,
            {
              method: "POST",

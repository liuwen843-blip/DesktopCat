      };

      function getSelectedAppearanceMode() {
        if (fields.modeGif && fields.modeGif.checked) return "gif";
        if (fields.modeLive2d && fields.modeLive2d.checked) return "live2d";
        return "classic";
      }

      function setAppearanceModeRadios(mode) {
        const m = mode || "classic";
        if (fields.modeClassic) fields.modeClassic.checked = m === "classic";
        if (fields.modeGif) fields.modeGif.checked = m === "gif";
        if (fields.modeLive2d) fields.modeLive2d.checked = m === "live2d";
      }

      function syncAppearancePanels() {
        const mode = getSelectedAppearanceMode();
        const gifPanels = document.getElementById("gif-panels");
        const livePanels = document.getElementById("live2d-panels");
        if (gifPanels) gifPanels.hidden = mode !== "gif";
        if (livePanels) livePanels.hidden = mode !== "live2d";
      }

      function refreshGifPreviews() {
        ["idle", "speaking", "clicked", "working"].forEach(function (key) {
          const row = document.querySelector('.gif-action-row[data-gif-action="' + key + '"]');
          if (!row) return;
          const input = row.querySelector("input[type='text']");
          const img = row.querySelector(".gif-preview");
          if (!img) return;
          const v = input && input.value.trim();
          const src = normalizeMediaSrc(v);
          if (src) {
            img.src = src;
            img.style.visibility = "visible";
          } else {
            img.removeAttribute("src");
            img.style.visibility = "hidden";
          }
        });
      }

      function readGifActionsFromForm() {
        return {
          idle: fields.gifIdle ? fields.gifIdle.value.trim() : "",
          speaking: fields.gifSpeaking ? fields.gifSpeaking.value.trim() : "",
          clicked: fields.gifClicked ? fields.gifClicked.value.trim() : "",
          working: fields.gifWorking ? fields.gifWorking.value.trim() : ""
        };
      }

      function writeGifActionsToForm(actions) {
        actions = actions || {};
        if (fields.gifIdle) fields.gifIdle.value = actions.idle || "";
        if (fields.gifSpeaking) fields.gifSpeaking.value = actions.speaking || "";
        if (fields.gifClicked) fields.gifClicked.value = actions.clicked || "";
        if (fields.gifWorking) fields.gifWorking.value = actions.working || "";
        refreshGifPreviews();
      }

      function readImageFileAsStored(file) {
        return new Promise(function (resolve, reject) {
          if (!file) {
            reject(new Error("empty"));
            return;
          }
          if (file.path) {
            resolve(toRelativeModelPath(file.path) || normalizeFsPath(file.path));
            return;
          }
          const reader = new FileReader();
          reader.onload = function () { resolve(String(reader.result || "")); };
          reader.onerror = function () { reject(new Error("read_fail")); };
          reader.readAsDataURL(file);
        });
      }

      function bindGifUi() {
        const fileInput = document.getElementById("gif-file");
        let pickTarget = "idle";
        document.querySelectorAll(".gif-pick").forEach(function (btn) {
          btn.addEventListener("click", function () {
            pickTarget = btn.getAttribute("data-gif-target") || "idle";
            if (fileInput) fileInput.click();
          });
        });
        if (fileInput) {
          fileInput.addEventListener("change", function () {
            const f = fileInput.files && fileInput.files[0];
            fileInput.value = "";
            if (!f) return;
            readImageFileAsStored(f)
              .then(function (val) {
                const map = {
                  idle: fields.gifIdle,
                  speaking: fields.gifSpeaking,
                  clicked: fields.gifClicked,
                  working: fields.gifWorking
                };
                const input = map[pickTarget];
                if (input) input.value = val;
                refreshGifPreviews();
                persistFromForm();
                showToast("已设置「" + pickTarget + "」动图", 1600);
              })
              .catch(function () {
                showToast("读取动图失败", 1800);
              });
          });
        }
        [fields.gifIdle, fields.gifSpeaking, fields.gifClicked, fields.gifWorking].forEach(function (el) {
          if (!el) return;
          el.addEventListener("input", refreshGifPreviews);
          el.addEventListener("change", function () {
            persistFromForm();
          });
        });
        [fields.modeClassic, fields.modeGif, fields.modeLive2d].forEach(function (el) {
          if (!el) return;
          el.addEventListener("change", function () {
            syncAppearancePanels();
            persistFromForm();
          });
        });
      }

      let toastTimer = null;
      function showToast(msg, ms) {
        const el = document.getElementById("toast");
        if (!el) return;
        el.textContent = msg || "已保存";
        el.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          el.classList.remove("show");
        }, ms || 1800);
      }

      /** OpenAI 兼容 Endpoint 归一化见 resolveChatCompletionsUrl / resolveModelsUrl */

      function fillModelSelect(list, current) {
        if (!fields.modelSelect) return;
        const ids = Array.isArray(list) ? list.filter(Boolean) : [];
        const cur = (current || fields.model.value || "").trim();
        fields.modelSelect.innerHTML = "";
        const manual = document.createElement("option");
        manual.value = "";
        manual.textContent = "手动输入 / 微调 ↓";
        fields.modelSelect.appendChild(manual);
        ids.forEach(function (id) {
          const opt = document.createElement("option");
          opt.value = id;
          opt.textContent = id;
          fields.modelSelect.appendChild(opt);
        });
        if (cur && ids.indexOf(cur) >= 0) {
          fields.modelSelect.value = cur;
        } else {
          fields.modelSelect.value = "";
        }
      }

      function readPersonaFields() {
        return {
          persona: fields.prompt.value,
          rules: fields.rules.value,
          negative: fields.negative.value
        };
      }

      function writePersonaFields(data) {
        fields.prompt.value = (data && data.persona) || "";
        fields.rules.value = (data && data.rules) || "";
        fields.negative.value = (data && data.negative) || "";
      }

      function fillSettingsForm() {
        store = loadStore();
        fields.llm.checked = !!store.llmEnabled;
        if (fields.offlineFirst) fields.offlineFirst.checked = !!store.preferOfflineCorpus;
        fields.autohide.checked = !!store.autoHideFullscreen;
        fields.intro.checked = store.introBounceEnabled !== false;
        fields.appAware.checked = !!store.appAwareEnabled;
        fields.typingAware.checked = !!store.typingAwareEnabled;
        setAppearanceModeRadios(store.appearanceMode || "classic");
        syncAppearancePanels();
        writeGifActionsToForm(store.gifActions);
        fields.endpoint.value = store.apiEndpoint || "";
        fields.apikey.value = store.apiKey || "";
        fields.model.value = store.modelName || "";
        fillModelSelect(store.llmModelList || [], store.modelName || "");
        fields.mmKey.value = store.minimaxKey || "";
        fields.mmGroup.value = store.minimaxGroup || "";
        fields.mmVoice.value = store.minimaxVoice || "";
        fields.mute.checked = !!store.voiceMuted;
        fields.volume.value = String(store.voiceVolume == null ? 80 : store.voiceVolume);
        fields.bubbleStay.value = String(store.bubbleStaySec == null ? 5 : store.bubbleStaySec);
        const stayLabel = document.getElementById("bubble-stay-label");
        if (stayLabel) stayLabel.textContent = fields.bubbleStay.value + "s";
        applyAudioSettings();
        writePersonaFields({
          persona: store.persona || DEFAULT_PERSONA,
          rules: store.rules || DEFAULT_RULES,
          negative: store.negative || DEFAULT_NEGATIVE
        });
        if (fields.live2dPath) {
          const cleanPath = sanitizeLive2dPath(store.live2dPath);
          fields.live2dPath.value = cleanPath;
          if (cleanPath !== store.live2dPath) {
            store = saveStore({ live2dPath: cleanPath });
          }
        }
        syncLive2dSizeUi(store.live2dSizeMul);
        renderFavList();
        renderOfflineList();
        renderWorldbookStatus();
      }

      function syncLive2dSizeUi(mul) {
        const m = clampLive2dSizeMul(mul);
        if (fields.live2dSize) fields.live2dSize.value = String(m);
        const label = document.getElementById("live2d-size-label");
        if (label) label.textContent = m.toFixed(2) + "×";
        document.querySelectorAll("[data-l2d-size]").forEach(function (btn) {
          const v = clampLive2dSizeMul(btn.getAttribute("data-l2d-size"));
          btn.classList.toggle("active", Math.abs(v - m) < 0.001);
        });
      }

      /** 持久化倍率并只缩放现有模型（绝不 loadModel） */
      function commitLive2dSizeMul(rawMul, opts) {
        opts = opts || {};
        const m = clampLive2dSizeMul(rawMul);
        syncLive2dSizeUi(m);
        store = saveStore({ live2dSizeMul: m }, { quiet: !!opts.quiet });
        if (!IS_SETTINGS_WINDOW) {
          applyLive2dSizeMul(m);
        } else if (!opts.quiet && window.bridge && typeof window.bridge.notifySettingsChanged === "function") {
          /* 仅在 change / 点预设时通知猫窗；猫窗只做缩放 */
          try { window.bridge.notifySettingsChanged(); } catch (_) {}
        }
        return m;
      }

      function persistFromForm(opts) {
        opts = opts || {};
        const prevMode = store.appearanceMode;
        const prevPath = sanitizeLive2dPath(store.live2dPath);
        const prevGif = JSON.stringify(store.gifActions || {});
        const personaBits = readPersonaFields();
        const appearanceMode = getSelectedAppearanceMode();
        const gifActions = readGifActionsFromForm();
        const live2dPath = sanitizeLive2dPath(
          fields.live2dPath ? fields.live2dPath.value.trim() : ""
        );
        if (fields.live2dPath && fields.live2dPath.value !== live2dPath) {
          fields.live2dPath.value = live2dPath;
        }
        const live2dSizeMul = clampLive2dSizeMul(
          fields.live2dSize ? fields.live2dSize.value : store.live2dSizeMul
        );

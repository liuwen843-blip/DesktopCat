      /** 本地现实时间上下文，供 LLM 判断早午晚/饭点/催睡 */
      function getLocalTimeContext() {
        const d = new Date();
        const pad = function (n) { return n < 10 ? "0" + n : String(n); };
        const weekNames = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"];
        const y = d.getFullYear();
        const mo = pad(d.getMonth() + 1);
        const day = pad(d.getDate());
        const h = d.getHours();
        const mi = pad(d.getMinutes());
        const week = weekNames[d.getDay()];
        let period = "白天";
        if (h >= 5 && h < 8) period = "清晨";
        else if (h >= 8 && h < 11) period = "上午";
        else if (h >= 11 && h < 14) period = "中午";
        else if (h >= 14 && h < 17) period = "下午";
        else if (h >= 17 && h < 19) period = "傍晚";
        else if (h >= 19 && h < 23) period = "夜晚";
        else period = "深夜";
        const stamp = y + "-" + mo + "-" + day + " " + pad(h) + ":" + mi;
        return "[当前现实时间：" + stamp + "，" + week + "，" + period + "]";
      }


      function sanitizeLive2dPath(p) {
        let s = String(p || "").trim().replace(/\\/g, "/");
        if (/^models\//i.test(s)) s = s.replace(/^models\//i, "");
        s = s.replace(/^\.\//, "");
        /* file:///.../haru/xxx → haru/xxx */
        if (/^file:/i.test(s)) {
          try {
            s = decodeURIComponent(s.replace(/^file:\/\/\//i, "").replace(/^file:\/\//i, ""));
          } catch (_) {
            s = s.replace(/^file:\/\/\//i, "").replace(/^file:\/\//i, "");
          }
        }
        const fsRoot = String(window.__PET_FS_ROOT__ || "").replace(/\\/g, "/").replace(/\/$/, "");
        if (fsRoot && s.toLowerCase().indexOf(fsRoot.toLowerCase() + "/") === 0) {
          s = s.slice(fsRoot.length + 1);
        }
        const haruIdx = s.toLowerCase().lastIndexOf("/haru/");
        if (haruIdx >= 0) s = s.slice(haruIdx + 1);
        if (!s) return "haru/haru_greeter_t03.model3.json";
        /* 浏览选择常只剩文件名：补上 haru/ 目录 */
        if (s.indexOf("/") < 0 && /\.model3?\.json$/i.test(s)) {
          s = "haru/" + s;
        }
        return s;
      }

      function clampLive2dSizeMul(v) {
        let n = Number(v);
        if (!isFinite(n)) n = 1;
        return Math.max(0.5, Math.min(1.8, Math.round(n * 100) / 100));
      }

      function loadStore() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return Object.assign({}, DEFAULT_SETTINGS);
          const parsed = JSON.parse(raw);
          const merged = Object.assign({}, DEFAULT_SETTINGS, parsed, {
            favorites: Array.isArray(parsed.favorites) ? parsed.favorites : [],
            offlineLines: Array.isArray(parsed.offlineLines) ? parsed.offlineLines : [],
            mealFired: parsed.mealFired && typeof parsed.mealFired === "object" ? parsed.mealFired : {},
            worldbooks: normalizeWorldbooks(parsed),
            gifActions: Object.assign(
              { idle: "", speaking: "", clicked: "", working: "" },
              parsed.gifActions && typeof parsed.gifActions === "object" ? parsed.gifActions : {}
            )
          });
          delete merged.worldbook;
          /* 兼容旧版 live2dEnabled 布尔开关 */
          if (!parsed.appearanceMode) {
            merged.appearanceMode = parsed.live2dEnabled ? "live2d" : "classic";
          }
          if (["classic", "gif", "live2d"].indexOf(merged.appearanceMode) < 0) {
            merged.appearanceMode = "classic";
          }
          merged.live2dEnabled = merged.appearanceMode === "live2d";
          merged.live2dPath = sanitizeLive2dPath(merged.live2dPath);
          /* 纠正历史脏路径并回写一次 */
          if (parsed && parsed.live2dPath !== merged.live2dPath) {
            try {
              localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(Object.assign({}, merged))
              );
            } catch (_) {}
          }
          merged.live2dSizeMul = clampLive2dSizeMul(
            merged.live2dSizeMul != null ? merged.live2dSizeMul : merged.live2dScale
          );
          delete merged.live2dScale;
          /* 兼容旧版单一 systemPrompt */
          if ((!parsed.persona && !parsed.rules && !parsed.negative) && parsed.systemPrompt) {
            merged.persona = String(parsed.systemPrompt);
            merged.rules = DEFAULT_RULES;
            merged.negative = DEFAULT_NEGATIVE;
          }
          merged.systemPrompt = buildSystemPrompt(merged);
          return merged;
        } catch (_) {
          return Object.assign({}, DEFAULT_SETTINGS);
        }
      }

      function saveStore(partial, opts) {
        opts = opts || {};
        const next = Object.assign(loadStore(), partial || {});
        delete next.worldbook;
        if (Array.isArray(next.worldbooks)) {
          next.worldbooks = next.worldbooks.map(function (book) {
            const entries = Array.isArray(book.entries) ? book.entries : [];
            return {
              id: book.id || newWorldbookId(),
              name: book.name || "未命名",
              entriesCount: entries.length,
              entries: entries
            };
          });
        }
        localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
        window.__petSettings = next;
        if (!opts.quiet) {
          syncAllToBridge(next);
          if (IS_SETTINGS_WINDOW && window.bridge && typeof window.bridge.notifySettingsChanged === "function") {
            try {
              window.bridge.notifySettingsChanged();
            } catch (_) {}
          }
        }
        return next;
      }

      function syncAutoHideToBridge(s) {
        s = s || store;
        if (window.bridge && window.bridge.setAutoHideFullscreen) {
          try {
            window.bridge.setAutoHideFullscreen(!!s.autoHideFullscreen);
          } catch (_) {}
        }
      }

      function syncAwareToBridge(s) {
        s = s || store;
        if (!window.bridge) return;
        try {
          if (window.bridge.setAppAwareEnabled) {
            window.bridge.setAppAwareEnabled(!!s.appAwareEnabled);
          }
          if (window.bridge.setTypingAwareEnabled) {
            window.bridge.setTypingAwareEnabled(!!s.typingAwareEnabled);
          }
        } catch (_) {}
      }

      function syncAllToBridge(s) {
        syncAutoHideToBridge(s);
        syncAwareToBridge(s);
      }

      let store = loadStore();
      window.__petSettings = store;

      /* =========================================================
       * Live2D（Pixi + pixi-live2d-display）
       * ========================================================= */
      let live2dApp = null;
      let live2dModel = null;
      let live2dTalking = false;
      let live2dMouthTimer = null;
      let live2dLoadToken = 0;
      let isLoadingModel = false;
      let isModelLoading = false; /* 别名，与 isLoadingModel 同步 */
      let live2dLoadedPath = "";
      let pendingLive2dPath = "";
      const live2dHost = document.getElementById("live2d-host");
      const live2dCanvas = document.getElementById("live2d-canvas");
      const live2dStatus = document.getElementById("live2d-status");

      function setLive2DStatus(msg, kind) {
        if (!live2dStatus) return;
        live2dStatus.textContent = msg || "";
        live2dStatus.className = "live2d-status" + (kind ? " " + kind : "");
      }

      function libsReady() {
        return !!(window.PIXI && window.PIXI.live2d && window.PIXI.live2d.Live2DModel);
      }

      function syncLive2DDomVisibility(mode) {
        const m = mode || (store && store.appearanceMode) || "classic";
        const isL2d = m === "live2d";
        if (live2dHost) {
          live2dHost.style.display = isL2d ? "block" : "none";
          live2dHost.setAttribute("aria-hidden", isL2d ? "false" : "true");
        }
        if (live2dCanvas) {
          live2dCanvas.style.display = isL2d ? "block" : "none";
        }
        if (cat) {
          if (isL2d) {
            cat.style.display = "none";
          } else {
            cat.style.display = "block";
          }
        }
        pet.classList.toggle("live2d-mode", isL2d);
        pet.classList.toggle("gif-mode", m === "gif");
      }

      function destroyLive2D() {
        live2dTalking = false;
        live2dLoadedPath = "";
        window.currentLive2DModel = null;
        window.removeEventListener("pointermove", onLive2DPointerMove, true);
        if (live2dMouthTimer) {
          clearInterval(live2dMouthTimer);
          live2dMouthTimer = null;
        }
        if (live2dModel) {
          try {
            if (live2dApp && live2dApp.stage) live2dApp.stage.removeChild(live2dModel);
            live2dModel.destroy({ children: true });
          } catch (_) {}
          live2dModel = null;
        }
        if (live2dApp) {
          try {
            if (live2dApp.ticker) live2dApp.ticker.stop();
            live2dApp.destroy(true, { children: true, texture: true, baseTexture: true });
          } catch (_) {}
          live2dApp = null;
        }
        window.app = null;
        window.currentLive2DModel = null;
        /* 清空 canvas 像素，避免残留帧继续被合成 */
        if (live2dCanvas) {
          try {
            const ctx = live2dCanvas.getContext("2d");
            if (ctx) ctx.clearRect(0, 0, live2dCanvas.width || 0, live2dCanvas.height || 0);
          } catch (_) {}
          live2dCanvas.style.display = "none";
        }
        if (live2dHost) live2dHost.style.display = "none";
        pet.classList.remove("live2d-mode");
        if (cat) cat.style.display = "block";
      }

      function onLive2DPointerMove(e) {
        if (!live2dModel || !store.live2dEnabled) return;
        try {
          if (typeof live2dModel.focus === "function") {
            live2dModel.focus(e.clientX, e.clientY);
          }
        } catch (_) {}
      }

      function listLive2DMotionGroups() {
        const fallback = ["Tap", "tap", "Idle", "Flick", "Shake", "FlickUp", "FlickDown", "FlickLeft", "FlickRight"];
        if (!live2dModel || !live2dModel.internalModel) return fallback;
        try {
          const defs = live2dModel.internalModel.motionManager && live2dModel.internalModel.motionManager.definitions;
          if (defs && typeof defs === "object") {
            const keys = Object.keys(defs).filter(function (k) {
              return defs[k] && defs[k].length;
            });
            if (keys.length) return keys;
          }
        } catch (_) {}
        return fallback;
      }

      function playRandomLive2DMotion() {
        if (!live2dModel || typeof live2dModel.motion !== "function") return;
        const groups = listLive2DMotionGroups();
        const shuffled = groups.slice().sort(function () { return Math.random() - 0.5; });
        (async function () {
          for (let i = 0; i < shuffled.length; i++) {
            try {
              await live2dModel.motion(shuffled[i]);
              return;
            } catch (_) {}
          }
        })();
      }

      function setLive2DMouth(v) {
        if (!live2dModel || !live2dModel.internalModel) return;
        try {
          const core = live2dModel.internalModel.coreModel;
          if (core && typeof core.setParameterValueById === "function") {
            core.setParameterValueById("ParamMouthOpenY", v);
            return;
          }
          if (core && typeof core.setParameterValueByUniqueId === "function") {
            /* Cubism2 fallback ignored */
          }
        } catch (_) {}
      }

      function ensureMouthTicker() {
        if (live2dMouthTimer) return;
        live2dMouthTimer = setInterval(function () {
          if (!live2dTalking || !live2dModel) {
            setLive2DMouth(0);
            return;
          }
          const v = Math.abs(Math.sin(Date.now() / 75)) * 0.75;
          setLive2DMouth(v);
        }, 40);
      }

      async function tryLive2DMotion(groups) {
        if (!live2dModel || typeof live2dModel.motion !== "function") return;
        const list = groups || [];
        for (let i = 0; i < list.length; i++) {
          try {
            await live2dModel.motion(list[i]);
            return;
          } catch (_) {}
        }
      }

      /** Live2D：画布高度自适应 × 用户安全倍率（绝不重载模型） */
      function getLive2dSizeMul() {
        store = loadStore();
        return clampLive2dSizeMul(store.live2dSizeMul);
      }

      function layoutLive2D() {
        if (!live2dApp || !live2dModel) return;
        const w = Math.max(2, live2dHost.clientWidth || 320);
        const h = Math.max(2, live2dHost.clientHeight || 400);
        try {
          live2dApp.renderer.resize(w, h);
        } catch (_) {}

        live2dModel.scale.set(1);
        const nativeH = Math.max(1, live2dModel.height);
        const base = (h * 0.95) / nativeH;
        const mul = getLive2dSizeMul();
        live2dModel.scale.set(base * mul);
        live2dModel.anchor.set(0, 0);
        live2dModel.x = (w - live2dModel.width) / 2;
        live2dModel.y = h - live2dModel.height;
        window.currentLive2DModel = live2dModel;
        window.app = live2dApp;
      }

      /** 仅改现有实例尺寸；供设置窗同步到猫窗时调用 */
      function applyLive2dSizeMul(mul) {
        if (IS_SETTINGS_WINDOW) return;
        const model = window.currentLive2DModel || live2dModel;
        const app = window.app || live2dApp;
        if (!model || !app || !app.renderer) return;
        const m = clampLive2dSizeMul(mul);
        model.scale.set(1);
        const base = (app.renderer.height * 0.95) / Math.max(1, model.height);
        model.scale.set(base * m);
        model.x = (app.renderer.width - model.width) / 2;
        model.y = app.renderer.height - model.height;
        window.currentLive2DModel = model;
        try {
          positionBubble();
          reportHitRect();
        } catch (_) {}
      }

      function resolveModelUrl(path) {
        let p = String(path || "").trim().replace(/\\/g, "/");
        if (!p) return "";
        if (/^(blob:|qrc:|data:)/i.test(p)) return p;
        if (/^https?:/i.test(p)) return p;
        /* 旧配置里可能残留 file:// —— 尽量映射回 HTTP 站点根 */
        if (/^file:/i.test(p)) {
          try {
            p = decodeURIComponent(
              p.replace(/^file:\/\/\//i, "").replace(/^file:\/\//i, "")
            );
          } catch (_) {
            p = p.replace(/^file:\/\/\//i, "").replace(/^file:\/\//i, "");
          }
        }
        const rel = toRelativeModelPath(p);
        let candidate = rel || p;
        /* 兼容旧占位符误写入的 models/ 前缀（仓库根下实际无 models/） */
        if (/^models\//i.test(candidate)) {
          candidate = candidate.replace(/^models\//i, "");
        }
        try {
          return new URL(candidate, window.location.href).href;
        } catch (_) {
          return candidate;
        }
      }

      /** Cubism 4: *.model3.json ；Cubism 2/3: *.model.json */
      function isLive2DModelConfigName(name) {
        const n = String(name || "");
        return /\.model3\.json$/i.test(n) || /\.model\.json$/i.test(n);
      }

      function preferModelConfigPath(a, b) {
        const score = function (p) {
          return /\.model3\.json$/i.test(p) ? 0 : 1;
        };
        return score(a) - score(b);
      }

      function normalizeFsPath(p) {
        return String(p || "").trim().replace(/\\/g, "/");
      }

      /** 尽量把绝对路径收成相对站点根的路径（绝不强行加 models/ 前缀） */
      function toRelativeModelPath(absOrRel) {
        let p = normalizeFsPath(absOrRel);
        if (!p) return "";
        if (/^(https?:|blob:|qrc:|data:)/i.test(p)) return p;
        if (/^file:/i.test(p)) {
          try {
            p = decodeURIComponent(
              p.replace(/^file:\/\/\//i, "").replace(/^file:\/\//i, "")
            );
          } catch (_) {
            p = p.replace(/^file:\/\/\//i, "").replace(/^file:\/\//i, "");
          }
        }

        /* HTTP 托管：盘符绝对路径 → 相对站点根（依赖 __PET_FS_ROOT__） */
        const fsRoot = normalizeFsPath(window.__PET_FS_ROOT__ || "").replace(/\/$/, "");
        if (fsRoot) {
          const full = p;
          if (full.toLowerCase().indexOf(fsRoot.toLowerCase() + "/") === 0) {
            return full.slice(fsRoot.length + 1);
          }
          if (full.toLowerCase() === fsRoot.toLowerCase()) {
            return "";
          }
        }

        try {
          const base = normalizeFsPath(decodeURIComponent(window.location.pathname || ""));
          const baseDir = base.replace(/\/[^/]*$/, "/");
          const full = p;
          if (
            baseDir &&
            baseDir !== "/" &&
            full.toLowerCase().indexOf(baseDir.toLowerCase()) === 0
          ) {
            return full.slice(baseDir.length);
          }
        } catch (_) {}
        return p;
      }

      function readDirectoryEntries(dirEntry) {
        return new Promise(function (resolve, reject) {
          const reader = dirEntry.createReader();
          const all = [];
          function readBatch() {
            reader.readEntries(function (batch) {
              if (!batch || !batch.length) {
                resolve(all);
                return;
              }
              all.push.apply(all, batch);
              readBatch();
            }, reject);
          }
          readBatch();
        });
      }

      function entryToFile(fileEntry) {
        return new Promise(function (resolve, reject) {
          fileEntry.file(resolve, reject);
        });
      }

      /** 递归扫描目录树，收集 { relativePath, file } */
      async function walkDirectoryEntry(dirEntry, prefix) {
        const out = [];
        const kids = await readDirectoryEntries(dirEntry);
        for (let i = 0; i < kids.length; i++) {
          const entry = kids[i];
          const rel = prefix ? prefix + "/" + entry.name : entry.name;
          if (entry.isFile) {
            try {
              const file = await entryToFile(entry);
              out.push({ relativePath: rel, file: file, name: entry.name });
            } catch (_) {}
          } else if (entry.isDirectory) {
            const sub = await walkDirectoryEntry(entry, rel);
            for (let j = 0; j < sub.length; j++) out.push(sub[j]);
          }
        }
        return out;
      }

      function pickBestModelFromCandidates(candidates) {
        if (!candidates || !candidates.length) return null;
        const list = candidates.slice().sort(function (a, b) {
          return preferModelConfigPath(a.name || a.relativePath, b.name || b.relativePath);
        });
        return list[0];
      }

      async function resolveLive2DPathFromDrop(dataTransfer) {
        if (!dataTransfer) return null;
        const items = dataTransfer.items ? Array.prototype.slice.call(dataTransfer.items) : [];

        /* 1) 优先：整文件夹（webkitGetAsEntry） */
        for (let i = 0; i < items.length; i++) {
          const item = items[i];
          if (!item || item.kind !== "file") continue;
          const entry = item.webkitGetAsEntry ? item.webkitGetAsEntry() : null;
          if (!entry || !entry.isDirectory) continue;
          setLive2DStatus("正在扫描模型文件夹…");
          const walked = await walkDirectoryEntry(entry, "");
          const models = walked.filter(function (x) {
            return isLive2DModelConfigName(x.name);
          });
          const best = pickBestModelFromCandidates(models);
          if (!best) {
            setLive2DStatus("文件夹内未找到 *.model3.json / *.model.json", "err");
            return null;
          }
          const filePath = best.file && best.file.path;
          if (filePath) {
            return toRelativeModelPath(filePath);
          }
          /* 无绝对路径：用文件夹名 + 相对路径（如 haru/xxx.model3.json），绝不拼 models/ */
          return normalizeFsPath(entry.name + "/" + best.relativePath);
        }

        /* 2) 多文件 / 单文件拖入 */
        const files = dataTransfer.files ? Array.prototype.slice.call(dataTransfer.files) : [];
        if (!files.length) return null;

        const modelFiles = files.filter(function (f) {
          return isLive2DModelConfigName(f.name);
        });
        if (modelFiles.length) {
          modelFiles.sort(function (a, b) {
            return preferModelConfigPath(a.name, b.name);
          });
          const f = modelFiles[0];
          return toRelativeModelPath(f.path || f.name);
        }

        /* 有 json 但不是主配置 */
        if (files.some(function (f) { return /\.json$/i.test(f.name); })) {
          setLive2DStatus("请拖入 *.model3.json / *.model.json，或整个模型文件夹", "err");
          return null;
        }
        setLive2DStatus("请拖入模型文件夹或主配置 json", "err");
        return null;
      }

      function applyLive2DPathAndLoad(path) {
        let p = sanitizeLive2dPath(path);
        if (!p) return;
        if (fields.live2dPath) fields.live2dPath.value = p;
        setAppearanceModeRadios("live2d");
        syncAppearancePanels();
        persistFromForm({ skipAppearanceApply: true });
        /* 设置窗只持久化；猫窗通过 bridge/storage 加载 */
        if (!IS_SETTINGS_WINDOW) {
          applyAppearanceMode();
        }
      }

      async function loadLive2DModel(path) {
        if (IS_SETTINGS_WINDOW) return false;
        if (!libsReady()) {
          setLive2DStatus("Live2D 库未加载（检查网络 CDN）", "err");
          return false;
        }
        const raw = sanitizeLive2dPath(path);
        if (!raw) {
          setLive2DStatus("请填写模型路径（*.model3.json / *.model.json）", "err");
          return false;
        }
        const url = resolveModelUrl(raw);
        if (!url) {
          setLive2DStatus("请填写有效的模型相对路径", "err");
          return false;
        }

        /* 同一模型已在场：只刷新布局 */
        if (live2dModel && live2dApp && live2dLoadedPath === raw) {
          syncLive2DDomVisibility("live2d");
          layoutLive2D();
          return true;
        }

        /* 防重入：同路径加载中忽略；换路径则作废旧任务 */
        if (isLoadingModel) {
          if (pendingLive2dPath === raw) return false;
          live2dLoadToken += 1;
          isLoadingModel = false;
          isModelLoading = false;
        }

        const token = ++live2dLoadToken;
        isLoadingModel = true;
        isModelLoading = true;
        pendingLive2dPath = raw;
        setLive2DStatus("正在加载模型…");
        destroyLive2D();
        syncLive2DDomVisibility("live2d");
        if (live2dCanvas) live2dCanvas.style.display = "block";
        if (live2dHost) live2dHost.style.display = "block";

        try {
          if (typeof window.__patchPixiShaderCheck === "function") {
            window.__patchPixiShaderCheck();
          }
          if (live2dCanvas) {
            const cw = (live2dHost && live2dHost.clientWidth) || 320;
            const ch = (live2dHost && live2dHost.clientHeight) || 400;
            if (!live2dCanvas.width) live2dCanvas.width = Math.max(2, cw);
            if (!live2dCanvas.height) live2dCanvas.height = Math.max(2, ch);
          }

          if (PIXI.settings && PIXI.ENV) {
            PIXI.settings.PREFER_ENV = PIXI.ENV.WEBGL;
          }

          /* WebGL 丢失时阻止默认行为，便于后续恢复 */
          if (live2dCanvas && !live2dCanvas.__petWebglHooks) {
            live2dCanvas.__petWebglHooks = true;
            live2dCanvas.addEventListener("webglcontextlost", function (e) {
              try { e.preventDefault(); } catch (_) {}
              console.warn("WebGL 上下文丢失，尝试重置…");
              live2dLoadedPath = "";
              try {
                if (live2dApp && live2dApp.ticker) live2dApp.ticker.stop();
              } catch (_) {}
            }, false);
            live2dCanvas.addEventListener("webglcontextrestored", function () {
              console.warn("WebGL 上下文已恢复，重新加载模型…");
              store = loadStore();
              if (store.appearanceMode === "live2d" && !isLoadingModel) {
                live2dLoadedPath = "";
                loadLive2DModel(store.live2dPath);
              }
            }, false);
          }

          /* 先用临时 canvas 探测 WebGL（勿占用 live2dCanvas，否则 PIXI 拿不到上下文） */
          let glOk = false;
          try {
            const probe = document.createElement("canvas");
            probe.width = 8;
            probe.height = 8;
            const gl =
              probe.getContext("webgl", {
                alpha: true,
                failIfMajorPerformanceCaveat: false
              }) ||
              probe.getContext("experimental-webgl", {
                alpha: true,
                failIfMajorPerformanceCaveat: false
              });
            glOk = !!gl;
          } catch (_) {
            glOk = false;
          }
          if (!glOk) {
            throw new Error(
              "WebGL仍不可用。请确认已进入色键表面（地址含 surface=l2d）。也可改用「自定义动图」模式。"
            );
          }

          live2dApp = new PIXI.Application({
            view: live2dCanvas,
            width: (live2dCanvas && live2dCanvas.width) || 320,
            height: (live2dCanvas && live2dCanvas.height) || 400,
            transparent: true,
            backgroundAlpha: 0,
            autoDensity: true,
            antialias: false,
            forceCanvas: false
          });
          window.app = live2dApp;
          if (live2dApp.renderer && live2dApp.renderer.backgroundColor != null) {
            live2dApp.renderer.backgroundColor = 0x000000;
          }

          const Live2DModel = PIXI.live2d.Live2DModel;
          if (PIXI.Ticker && Live2DModel.registerTicker) {
            Live2DModel.registerTicker(PIXI.Ticker);
          }

          const model = await Live2DModel.from(url, {
            autoInteract: false,
            autoHitTest: true,
            idleMotionGroup: "Idle"
          });
          if (token !== live2dLoadToken) {
            try { model.destroy(); } catch (_) {}
            return false;
          }
          live2dModel = model;
          live2dLoadedPath = raw;
          window.currentLive2DModel = model;
          window.app = live2dApp;
          model.interactive = true;
          model.buttonMode = true;
          live2dApp.stage.addChild(model);
          pet.classList.add("live2d-mode");
          if (cat) cat.style.display = "none";
          /* 初次布局：按画布高度自动适配 */
          layoutLive2D();
          ensureMouthTicker();

          window.addEventListener("pointermove", onLive2DPointerMove, true);

          model.on("hit", function () {
            playRandomLive2DMotion();
          });
          model.on("pointertap", function () {
            playRandomLive2DMotion();
          });

          setLive2DStatus("模型已加载：" + raw, "ok");
          reportHitRect();
          return true;
        } catch (err) {
          if (token === live2dLoadToken) destroyLive2D();
          console.warn("[Live2D] 加载失败", raw, url, err);
          setLive2DStatus(
            "加载失败：请确认路径相对 index.html，且同目录含纹理/动作等资源",
            "err"
          );
          return false;
        } finally {
          if (token === live2dLoadToken) {
            isLoadingModel = false;
            isModelLoading = false;
            pendingLive2dPath = "";
          }
        }
      }

      /* =========================================================
       * 自定义动图状态机
       * ========================================================= */
      let petVisualState = "idle";
      let clickedVisualTimer = null;
      let workingIdleTimer = null;
      let workingVisualActive = false;

      function normalizeMediaSrc(p) {
        const s = String(p || "").trim();
        if (!s) return "";
        if (/^(data:|https?:|blob:)/i.test(s)) return s;
        if (/^file:/i.test(s)) return s;
        const norm = s.replace(/\\/g, "/");
        if (/^[a-zA-Z]:\//.test(norm)) {
          return "file:///" + norm;
        }
        try {
          return new URL(norm, window.location.href).href;
        } catch (_) {
          return norm;
        }
      }

      function getGifSrcForState(stateName) {
        store = loadStore();
        const map = store.gifActions || {};
        const idle = String(map.idle || "").trim();
        const specific = String(map[stateName] || "").trim();
        return normalizeMediaSrc(specific || idle);
      }

      /** 全局外观状态切换：idle / speaking / clicked / working */
      function setPetState(stateName, opts) {
        opts = opts || {};
        if (IS_SETTINGS_WINDOW) return;
        const name = String(stateName || "idle");
        store = loadStore();
        const mode = store.appearanceMode || "classic";

        if (mode !== "gif") {
          petVisualState = name;
          return;
        }

        petVisualState = name;
        pet.classList.add("gif-mode");
        pet.classList.remove("live2d-mode");

        const src = getGifSrcForState(name);
        if (!src) {
          /* 无任何动图时保留当前图，避免空白 */
          return;
        }

        /* 重新赋值以重启 GIF 循环（同 src 也强制刷新） */
        if (opts.restart || cat.getAttribute("src") === src) {
          cat.removeAttribute("src");
        }
        cat.src = src;

        pet.classList.toggle("gif-speaking", name === "speaking");
        pet.classList.toggle("gif-working", name === "working");
        pet.classList.toggle("gif-clicked", name === "clicked");
      }

      function resolveVisualAfterTemp() {
        store = loadStore();
        if (store.appearanceMode !== "gif") return;
        if (pet.classList.contains("talking")) {
          setPetState("speaking", { restart: false });
        } else if (workingVisualActive) {
          setPetState("working", { restart: false });
        } else {
          setPetState("idle", { restart: false });
        }
      }

      function triggerClickedVisual() {
        store = loadStore();
        if (store.appearanceMode !== "gif") return;
        setPetState("clicked", { restart: true });
        clearTimeout(clickedVisualTimer);
        clickedVisualTimer = setTimeout(function () {
          resolveVisualAfterTemp();
        }, 1600);
      }

      function isLive2dSurfaceReady() {
        return (
          document.documentElement.classList.contains("l2d-surface") ||
          /(?:^\?|&)surface=l2d(?:&|$)/.test(location.search || "")
        );
      }

      function requestLive2dSurface(enabled) {
        return new Promise(function (resolve) {
          if (!window.bridge || typeof window.bridge.setLive2dSurface !== "function") {
            resolve(false);
            return;
          }
          var settled = false;
          function done(v) {
            if (settled) return;
            settled = true;
            resolve(!!v);
          }
          try {
            /* QWebChannel：有返回值的 slot 用回调；部分环境也会同步返回 */
            var ret = window.bridge.setLive2dSurface(!!enabled, function (reloaded) {
              done(reloaded);
            });
            if (typeof ret === "boolean") done(ret);
            setTimeout(function () { done(true); }, 120);
          } catch (_) {
            done(false);
          }
        });
      }

      async function applyAppearanceMode() {
        if (IS_SETTINGS_WINDOW) return;
        store = loadStore();
        const mode = store.appearanceMode || "classic";

        if (mode === "live2d") {
          pet.classList.remove("gif-mode");

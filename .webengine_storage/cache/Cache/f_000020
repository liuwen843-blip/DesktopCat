        } catch (err) {
          const elapsed = performance.now() - t0;
          const isTimeout = err && err.name === "AbortError";
          console.warn("[离线台词库] 失败 耗时=" + formatElapsedMs(elapsed), err);
          showToast(
            isTimeout
              ? "生成超时（" + formatElapsedMs(elapsed) + "），请稍后重试"

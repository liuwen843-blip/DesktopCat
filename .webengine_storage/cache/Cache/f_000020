      /* =========================================================
       * 气泡 / 收藏
       * ========================================================= */
      let currentLine = "";
      let bubbleTimer = null;
      let hoverLocked = false;
      let bubblePaused = false;
      let bubbleRemainMs = 0;
      let bubbleHideAt = 0;
      let bubbleAutoHide = false;

      function getBubbleStayMs() {
        try {
          store = loadStore();
        } catch (_) {}
        const sec = Math.max(2, Math.min(15, Number(store.bubbleStaySec == null ? 5 : store.bubbleStaySec)));
        return sec * 1000;
      }

      function clearBubbleTimer() {
        clearTimeout(bubbleTimer);
        bubbleTimer = null;
      }

      function scheduleBubbleHide(ms) {
        clearBubbleTimer();
        const wait = Math.max(0, Number(ms) || 0);
        bubbleRemainMs = wait;
        bubbleHideAt = Date.now() + wait;
        bubbleAutoHide = wait > 0;
        if (!bubbleAutoHide || bubblePaused) return;
        bubbleTimer = setTimeout(function () {
          bubbleTimer = null;
          bubbleRemainMs = 0;
          hideBubble();
        }, wait);
      }

      function pauseBubbleTimer() {
        if (!bubbleAutoHide) return;
        bubblePaused = true;
        if (bubbleTimer) {
          clearBubbleTimer();
          bubbleRemainMs = Math.max(0, bubbleHideAt - Date.now());
        }
      }

      function resumeBubbleTimer() {
        if (!bubbleAutoHide) return;
        bubblePaused = false;
        if (bubbleRemainMs > 0) scheduleBubbleHide(bubbleRemainMs);
      }

      /** 语音播放时长与设置停留时长取较大值 */
      function extendBubbleForAudio(audioMs) {
        if (!bubbleAutoHide) return;
        const stay = getBubbleStayMs();
        const need = Math.max(stay, (Number(audioMs) || 0) + 350);
        const left = Math.max(0, bubbleHideAt - Date.now());
        if (need > left) {
          if (bubblePaused) {
            bubbleRemainMs = need;
            bubbleHideAt = Date.now() + need;
          } else {
            scheduleBubbleHide(need);
          }
        }
      }

      function isFavorited(text) {
        return store.favorites.indexOf(text) !== -1;
      }

      function syncStar() {
        if (!currentLine || bubble.classList.contains("hover-tip")) {
          favStar.classList.remove("on");
          return;
        }
        favStar.classList.toggle("on", isFavorited(currentLine));
      }

      function hideBubble() {
        clearBubbleTimer();
        stopBubbleAutoScroll();
        bubbleAutoHide = false;
        bubblePaused = false;
        bubbleRemainMs = 0;
        bubble.classList.remove("show", "pos-chest", "pos-side", "pos-left");
        bubble.style.left = "";
        bubble.style.top = "";
        bubble.style.bottom = "";
        bubble.style.transform = "";
        if (!hoverLocked) {
          bubble.classList.add("hover-tip");
          bubbleText.textContent = "盯——";
          currentLine = "";
          favStar.classList.remove("on");
        }
        reportHitRect();
      }

      let bubbleScrollRaf = null;
      let bubbleScrollDelay = null;

      function stopBubbleAutoScroll() {
        if (bubbleScrollRaf) {
          cancelAnimationFrame(bubbleScrollRaf);
          bubbleScrollRaf = null;
        }
        if (bubbleScrollDelay) {
          clearTimeout(bubbleScrollDelay);
          bubbleScrollDelay = null;
        }
        if (bubbleContent) bubbleContent.scrollTop = 0;
      }

      /** 长文超出高度时匀速自动向下滚完，无需手动拖滚动条 */
      function startBubbleAutoScroll() {
        stopBubbleAutoScroll();
        if (!bubbleContent || bubble.classList.contains("hover-tip")) return;
        bubbleContent.scrollTop = 0;
        bubbleScrollDelay = setTimeout(function () {
          bubbleScrollDelay = null;
          if (!bubble.classList.contains("show")) return;
          const maxScroll = bubbleContent.scrollHeight - bubbleContent.clientHeight;
          if (maxScroll <= 2) return;
          const speed = Math.max(0.35, maxScroll / 180);
          function step() {
            if (!bubble.classList.contains("show")) return;
            const top = bubbleContent.scrollTop;
            if (top >= maxScroll - 0.5) {
              bubbleScrollDelay = setTimeout(function () {
                if (!bubble.classList.contains("show")) return;
                bubbleContent.scrollTop = 0;
                startBubbleAutoScroll();
              }, 1400);
              return;
            }
            bubbleContent.scrollTop = top + speed;
            bubbleScrollRaf = requestAnimationFrame(step);
          }
          bubbleScrollRaf = requestAnimationFrame(step);
        }, 700);
      }

      /** 气泡锚定头部上方，并按窗口边界自动改侧边/胸口，保证全文可见 */
      function positionBubble() {
        if (!bubble.classList.contains("show")) return;
        if (bubble.classList.contains("hover-tip")) {
          bubble.classList.remove("pos-chest", "pos-side", "pos-left");
          return;
        }

        bubble.classList.remove("pos-chest", "pos-side", "pos-left");
        /* 默认：模型头顶上方居中 */
        void bubble.offsetWidth;

        const pad = 10;
        const winW = window.innerWidth || document.documentElement.clientWidth || 0;
        const winH = window.innerHeight || document.documentElement.clientHeight || 0;
        let br = bubble.getBoundingClientRect();

        /* 顶部出界 → 胸口前方 */
        if (br.top < pad) {
          bubble.classList.add("pos-chest");
          void bubble.offsetWidth;
          br = bubble.getBoundingClientRect();
        }
        /* 仍顶部出界或右侧出界 → 右侧 */
        if (br.top < pad || br.right > winW - pad) {
          bubble.classList.remove("pos-chest");
          bubble.classList.add("pos-side");
          void bubble.offsetWidth;
          br = bubble.getBoundingClientRect();
        }
        /* 左侧出界 */
        if (br.left < pad) {
          bubble.classList.remove("pos-side", "pos-chest");
          bubble.classList.add("pos-left");
          void bubble.offsetWidth;
          br = bubble.getBoundingClientRect();
        }
        /* 右侧仍出界时钳制到视口内（微调 left） */
        br = bubble.getBoundingClientRect();
        if (br.right > winW - pad) {
          const overflow = br.right - (winW - pad);
          const petRect = pet.getBoundingClientRect();
          const curLeft = br.left - petRect.left;
          bubble.style.left = Math.max(8, curLeft - overflow) + "px";
          bubble.style.transform = "translateX(0) translateY(0) scale(1)";
        } else if (!bubble.classList.contains("pos-chest") && !bubble.classList.contains("pos-side") && !bubble.classList.contains("pos-left")) {
          bubble.style.left = "";
          bubble.style.transform = "";
        } else {
          bubble.style.left = "";
        }

        /* 底部出界：略上移 */
        br = bubble.getBoundingClientRect();
        if (br.bottom > winH - pad) {
          const petRect = pet.getBoundingClientRect();
          const topInPet = Math.max(8, (winH - pad - br.height) - petRect.top);
          bubble.style.top = topInPet + "px";
          bubble.style.bottom = "auto";
        } else if (!bubble.classList.contains("pos-chest") && !bubble.classList.contains("pos-side")) {
          bubble.style.top = "";
          bubble.style.bottom = "";
        }
      }

      function showBubble(text, opts) {
        opts = opts || {};
        const favoritable = opts.favoritable !== false;
        const asHover = !!opts.hover;
        const sticky = opts.duration === 0 || !!opts.sticky;
        /* 非悬停、非禁声的对话气泡一律可朗读（含 sticky / 离线库 / ✨ LLM 回复） */
        const withVoice = opts.voice !== false && favoritable && !asHover;

        clearBubbleTimer();
        bubblePaused = false;
        currentLine = text || "";
        bubbleText.textContent = currentLine;
        bubble.classList.toggle("hover-tip", asHover || !favoritable);
        bubble.classList.add("show");
        bubble.style.left = "";
        bubble.style.top = "";
        bubble.style.bottom = "";
        bubble.style.transform = "";
        syncStar();
        requestAnimationFrame(function () {
          positionBubble();
          startBubbleAutoScroll();
          reportHitRect();
        });

        let voiceJob = null;
        if (withVoice && currentLine) {
          /* 返回 Promise：合成并开始播放后 resolve（非播完） */
          voiceJob = Promise.resolve(playMinimaxTTS(currentLine));
        }

        /* sticky / 悬停提示：不自动消失 */
        if (sticky || asHover) {
          bubbleAutoHide = false;
          bubbleRemainMs = 0;
          reportHitRect();
          return voiceJob;
        }

        scheduleBubbleHide(getBubbleStayMs());
        reportHitRect();
        return voiceJob;
      }


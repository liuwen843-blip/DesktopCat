            LLM_BATCH_TIMEOUT_MS
          );
          const elapsed = performance.now() - t0;
          const bodyText = await res.text();
          if (!res.ok) {
            console.warn("[离线台词库] HTTP " + res.status + " 耗时=" + formatElapsedMs(elapsed), bodyText.slice(0, 500));
            showToast("生成失败：HTTP " + res.status + "（" + formatElapsedMs(elapsed) + "）", 2600);

      /** 解析 SillyTavern 世界书 JSON → 精简词条数组 */
      function parseWorldbookJson(raw) {
        let data = raw;
        if (typeof raw === "string") data = JSON.parse(raw);
        if (!data || typeof data !== "object") throw new Error("invalid json");

        let entries = data.entries;
        if (!entries && Array.isArray(data)) entries = data;
        if (!entries && data.entries === undefined && typeof data === "object") {
          /* 有的导出直接是 uid→entry 映射 */
          const maybe = Object.keys(data).every(function (k) {
            const v = data[k];
            return v && typeof v === "object" && ("content" in v || "key" in v || "keys" in v);
          });
          if (maybe) entries = data;
        }
        if (!entries) throw new Error("missing entries");

        const list = Array.isArray(entries)
          ? entries
          : Object.keys(entries).map(function (k) { return entries[k]; });

        const out = [];
        for (let i = 0; i < list.length; i++) {
          const e = list[i];
          if (!e || typeof e !== "object") continue;
          if (e.disable === true || e.enabled === false) continue;
          const keysRaw = e.key != null ? e.key : e.keys;
          const keys = [].concat(keysRaw || [])
            .map(function (k) { return String(k == null ? "" : k).trim(); })
            .filter(Boolean)
            .slice(0, 40);
          let content = String(e.content || "").trim();
          if (!content) continue;
          if (content.length > WB_ENTRY_CONTENT_MAX) {
            content = content.slice(0, WB_ENTRY_CONTENT_MAX) + "…";
          }
          out.push({
            keys: keys,
            content: content,
            constant: !!e.constant
          });
          if (out.length >= WB_ENTRIES_MAX) break;
        }
        return out;
      }

      function newWorldbookId() {
        return "wb_" + Date.now().toString(36) + "_" + Math.random().toString(36).slice(2, 8);
      }

      /** 兼容旧版单一 worldbook[]，统一为 worldbooks 列表 */
      function normalizeWorldbooks(parsed) {
        parsed = parsed || {};
        if (Array.isArray(parsed.worldbooks) && parsed.worldbooks.length) {
          return parsed.worldbooks.map(function (book, i) {
            const entries = Array.isArray(book && book.entries) ? book.entries : [];
            return {
              id: (book && book.id) || ("wb_legacy_" + i),
              name: (book && book.name) || ("世界书 " + (i + 1)),
              entriesCount: entries.length,
              entries: entries
            };
          });
        }
        if (Array.isArray(parsed.worldbook) && parsed.worldbook.length) {
          const first = parsed.worldbook[0];
          if (first && Array.isArray(first.entries)) {
            return normalizeWorldbooks({ worldbooks: parsed.worldbook });
          }
          return [{
            id: "wb_migrated",
            name: "已迁移世界书",
            entriesCount: parsed.worldbook.length,
            entries: parsed.worldbook
          }];
        }
        return [];
      }

      function flattenWorldbookEntries(s) {
        const books = (s && s.worldbooks) || [];
        const all = [];
        for (let i = 0; i < books.length; i++) {
          const entries = books[i] && books[i].entries;
          if (!entries || !entries.length) continue;
          for (let j = 0; j < entries.length; j++) {
            all.push(entries[j]);
          }
        }
        return all;
      }

      /** 按 User Prompt 扫描世界书：常驻强制 + 关键词触发（默认精简，防超长） */
      function scanWorldbook(userPrompt, entries, opts) {
        opts = opts || {};
        const lean = opts.lean !== false;
        const hay = String(userPrompt || "");
        const hayLower = hay.toLowerCase();
        const picked = [];
        let constantCount = 0;
        const src = Array.isArray(entries) ? entries : [];
        for (let i = 0; i < src.length; i++) {
          const e = src[i];
          if (!e || !e.content) continue;
          if (e.constant) {
            if (lean && constantCount >= WB_CONSTANT_MAX) continue;
            let content = String(e.content);
            if (lean && content.length > WB_CONSTANT_EACH_MAX) {
              content = content.slice(0, WB_CONSTANT_EACH_MAX) + "…";
            }
            picked.push(content);
            constantCount += 1;
            continue;
          }
          const keys = e.keys || [];
          for (let j = 0; j < keys.length; j++) {
            const k = keys[j];
            if (!k) continue;
            if (hay.indexOf(k) !== -1 || hayLower.indexOf(String(k).toLowerCase()) !== -1) {
              let content = String(e.content);
              if (lean && content.length > WB_CONSTANT_EACH_MAX) {
                content = content.slice(0, WB_CONSTANT_EACH_MAX) + "…";
              }
              picked.push(content);
              break;
            }
          }
        }
        return picked;
      }

      function mergeWorldbookBlock(parts, maxLen) {
        if (!parts || !parts.length) return "";
        const limit = maxLen == null ? WB_PROMPT_MAX : maxLen;
        let merged = parts.join("\n");
        if (merged.length > limit) {
          merged = merged.slice(0, limit) + "\n…(世界书内容已截断，防止 Token 过长)";
        }
        return "\n\n[附加思维与设定库]\n" + merged;
      }

      /** 发给 LLM 的完整 System：人设 + 时间 + 命中世界书（有总长截断） */
      function buildSystemPromptForLlm(s, userPrompt) {
        s = s || store;
        let base = buildSystemPrompt(s) + "\n\n" + getLocalTimeContext();
        try {
          const parts = scanWorldbook(userPrompt, flattenWorldbookEntries(s), { lean: true });
          base += mergeWorldbookBlock(parts, WB_PROMPT_MAX);
        } catch (_) { /* 世界书异常时降级为人设-only */ }
        if (base.length > SYSTEM_TOTAL_MAX) {
          base = base.slice(0, SYSTEM_TOTAL_MAX) + "\n…(上下文已截断，防止超时/超限)";
        }
        return base;
      }


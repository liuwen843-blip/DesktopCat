        const ctx = getAudioCtx();
        const t0 = ctx.currentTime;
        const dur = 0.28;
        const osc = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const gain = ctx.createGain();
        const filter = ctx.createBiquadFilter();
        osc.type = "triangle";
        osc2.type = "sine";
        filter.type = "bandpass";
        filter.frequency.setValueAtTime(1200, t0);
        filter.Q.value = 4;
        osc.frequency.setValueAtTime(980, t0);
        osc.frequency.exponentialRampToValueAtTime(420, t0 + dur);
        osc2.frequency.setValueAtTime(1460, t0);
        osc2.frequency.exponentialRampToValueAtTime(560, t0 + dur);
        gain.gain.setValueAtTime(0.0001, t0);
        gain.gain.exponentialRampToValueAtTime(0.22, t0 + 0.025);
        gain.gain.exponentialRampToValueAtTime(0.12, t0 + 0.12);
        gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
        osc.connect(filter);
        osc2.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t0);
        osc2.start(t0);
        osc.stop(t0 + dur + 0.02);
        osc2.stop(t0 + dur + 0.02);
      }

      function playMeow() {
        getAudioCtx();
        if (meowMp3Ready && meowMp3) {
          try {
            const clip = meowMp3.cloneNode();
            clip.volume = 0.85;
            const p = clip.play();
            if (p && p.catch) p.catch(playSynthMeow);
            return;
          } catch (_) {}
        }
        playSynthMeow();
      }

      function playWhoosh() {
        const ctx = getAudioCtx();
        const t0 = ctx.currentTime;
        const dur = 0.32;
        const sampleRate = ctx.sampleRate;
        const len = Math.floor(sampleRate * dur);
        const buffer = ctx.createBuffer(1, len, sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const src = ctx.createBufferSource();
        src.buffer = buffer;
        const filter = ctx.createBiquadFilter();
        filter.type = "bandpass";
        filter.Q.value = 1.2;
        filter.frequency.setValueAtTime(2400, t0);
        filter.frequency.exponentialRampToValueAtTime(280, t0 + dur);
        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.0001, t0);
        gain.gain.exponentialRampToValueAtTime(0.35, t0 + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
        const whistle = ctx.createOscillator();
        whistle.type = "sine";
        whistle.frequency.setValueAtTime(900, t0);
        whistle.frequency.exponentialRampToValueAtTime(180, t0 + dur);
        const wGain = ctx.createGain();
        wGain.gain.setValueAtTime(0.0001, t0);
        wGain.gain.exponentialRampToValueAtTime(0.08, t0 + 0.015);
        wGain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
        src.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        whistle.connect(wGain);
        wGain.connect(ctx.destination);
        src.start(t0);
        whistle.start(t0);
        src.stop(t0 + dur);
        whistle.stop(t0 + dur + 0.02);
      }

      /* =========================================================
       * 宠物互动（咬住 / 拖拽 / 甩飞）
       * ========================================================= */
      const IDLE = "idle";
      const BITING = "biting";
      const THROWING = "throwing";
      let state = IDLE;

      let dragging = false;
      let dragMoved = false;
      let startX = 0;
      let startY = 0;
      let originX = 0;
      let originY = 0;
      let biteClicks = 0;
      let biteClickTimer = null;

      let lastMoveX = 0;
      let lastMoveY = 0;
      let lastMoveT = 0;
      let shakeBoost = 0;
      let shakeDecayId = null;

      function setShakeAmp(boost) {
        const t = Math.min(1, Math.max(0, boost));
        catWrap.style.setProperty("--shake-x", (3 + t * 7).toFixed(1) + "px");
        catWrap.style.setProperty("--shake-y", (2 + t * 6).toFixed(1) + "px");
        catWrap.style.setProperty("--shake-rot", (4 + t * 10).toFixed(1) + "deg");
      }

      function clearShakeAmp() {
        shakeBoost = 0;
        if (shakeDecayId) {
          cancelAnimationFrame(shakeDecayId);
          shakeDecayId = null;
        }
        catWrap.style.removeProperty("--shake-x");
        catWrap.style.removeProperty("--shake-y");
        catWrap.style.removeProperty("--shake-rot");
      }

      function updateShakeFromSpeed(clientX, clientY) {
        const now = performance.now();
        if (lastMoveT) {
          const dt = Math.max(8, now - lastMoveT);
          const speed = Math.hypot(clientX - lastMoveX, clientY - lastMoveY) / dt;
          shakeBoost = Math.max(shakeBoost * 0.65, Math.min(1, speed / 1.8));
          setShakeAmp(shakeBoost);
        }
        lastMoveX = clientX;
        lastMoveY = clientY;
        lastMoveT = now;
        if (!shakeDecayId) {
          const decay = function () {
            if (state !== BITING) {
              shakeDecayId = null;
              return;
            }
            shakeBoost *= 0.9;
            if (shakeBoost < 0.04) {
              shakeBoost = 0;
              setShakeAmp(0);
              shakeDecayId = null;
              return;
            }
            setShakeAmp(shakeBoost);
            shakeDecayId = requestAnimationFrame(decay);
          };
          shakeDecayId = requestAnimationFrame(decay);
        }
      }

      function placeAt(x, y, biting) {
        pet.style.left = x + "px";
        pet.style.top = y + "px";
        pet.style.transform = biting ? "translate(-48%, -58%)" : "translate(-50%, -50%)";
      }

      function getCenter() {
        const r = pet.getBoundingClientRect();
        return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
      }

      function enterBite(x, y) {
        state = BITING;
        dragging = false;
        pet.classList.remove("floating", "dragging", "daydream");
        pet.classList.add("biting");
        store = loadStore();
        if (store.appearanceMode === "gif") {
          triggerClickedVisual();
        } else if (store.appearanceMode !== "live2d") {
          cat.src = "cat2.png";
        }
        body.classList.add("hiding-cursor");
        biteClicks = 1;
        clearTimeout(biteClickTimer);
        biteClickTimer = setTimeout(function () { biteClicks = 0; }, BITE_CLICK_WINDOW);
        lastMoveX = x;
        lastMoveY = y;
        lastMoveT = performance.now();
        setShakeAmp(0);
        playMeow();
        if (shouldUseOfflineFirst({})) {
          /* 省 Token：直接本地冒泡，不显示加载中 */
        } else if (llmReady(store)) {
          showBubble("…", { favoritable: false, duration: 0, voice: false });
        } else {
          showBubble(fallbackLine(POKE_LINES), { favoritable: true, duration: 0, voice: false });
        }
        placeAt(x, y, true);
        if (window.bridge && window.bridge.setPetBusy) window.bridge.setPetBusy(true);
        reportHitRect();
        markActivity();
        speak(POKE_USER_PROMPT, POKE_LINES, {
          allowBusyStates: true,
          force: true,
          duration: 0
        });
      }

      function resetIdle(afterThrow) {
        state = IDLE;
        biteClicks = 0;
        clearTimeout(biteClickTimer);
        clearShakeAmp();
        pet.classList.remove("biting", "throwing", "dragging");
        store = loadStore();
        if (store.appearanceMode === "gif") {
          resolveVisualAfterTemp();
        } else if (store.appearanceMode !== "live2d") {
          cat.src = "cat1.png";
        }
        body.classList.remove("hiding-cursor");
        hideBubble();
        if (window.bridge && window.bridge.setPetBusy) {
          window.bridge.setPetBusy(false);
        }
        if (afterThrow) {
          pet.style.left = "50%";
          pet.style.top = "50%";
          pet.style.transform = "translate(-50%, -50%)";
          pet.style.opacity = "0";
          pet.classList.add("floating");
          requestAnimationFrame(function () {
            pet.style.transition = "opacity 0.35s ease";
            pet.style.opacity = "1";
            setTimeout(function () { pet.style.transition = ""; }, 400);
          });
        } else {
          pet.classList.add("floating");
        }
        reportHitRect();
      }

      function throwCursor() {
        if (state !== BITING) return;
        state = THROWING;
        clearShakeAmp();
        playWhoosh();
        showBubble("💢 走开啦！", { favoritable: true, voice: true });
        pet.classList.remove("biting", "floating");
        pet.classList.add("throwing");
        body.classList.remove("hiding-cursor");
        if (window.bridge && window.bridge.flingSystemCursor) window.bridge.flingSystemCursor();
        if (window.bridge && window.bridge.setPetBusy) window.bridge.setPetBusy(true);

        function onEnd(e) {
          if (e.animationName !== "throwAway") return;
          pet.removeEventListener("animationend", onEnd);
          pet.classList.remove("throwing");
          resetIdle(true);
        }
        pet.addEventListener("animationend", onEnd);
      }

      function registerBiteClick() {
        if (state !== BITING) return;
        biteClicks += 1;
        clearTimeout(biteClickTimer);
        biteClickTimer = setTimeout(function () { biteClicks = 0; }, BITE_CLICK_WINDOW);
        if (biteClicks >= 5) throwCursor();
      }

      function reportHitRect() {
        if (!window.bridge || !window.bridge.updateHitRect) return;
        let left = Infinity, top = Infinity, right = -Infinity, bottom = -Infinity;
        const nodes = [pet];
        if (chatSpark) nodes.push(chatSpark);
        if (bubble.classList.contains("show")) nodes.push(bubble);
        nodes.forEach(function (el) {
          if (!el) return;
          const r = el.getBoundingClientRect();
          if (!r.width && !r.height) return;
          left = Math.min(left, r.left);
          top = Math.min(top, r.top);
          right = Math.max(right, r.right);
          bottom = Math.max(bottom, r.bottom);
        });
        if (!isFinite(left)) return;
        window.bridge.updateHitRect(left, top, right - left, bottom - top);
      }

      function isUiChromeTarget(el) {
        if (!el || !el.closest) return false;
        return !!(
          el.closest("#fav-star") ||
          el.closest("#chat-spark") ||
          el.closest("#bubble")
        );
      }

      window.__onPetBridgeReady = function () {
        syncAllToBridge(store);
        reportHitRect();
        /* 首屏可能早于 bridge；Live2D 需等桥接后再切色键表面 */
        try {
          store = loadStore();
          if ((store.appearanceMode || "classic") === "live2d") {
            applyAppearanceMode();
          }
        } catch (_) {}
      };

      /* Python → 前台软件感知 */
      window.__onForegroundApp = function (info) {
        try {
          store = loadStore();
          if (!store.appAwareEnabled) return;
          if (state === BITING || state === THROWING) return;
          workingVisualActive = true;
          clearTimeout(workingIdleTimer);
          if (store.appearanceMode === "gif" && !pet.classList.contains("talking")) {
            setPetState("working", { restart: true });
          }
          workingIdleTimer = setTimeout(function () {
            workingVisualActive = false;
            resolveVisualAfterTemp();
          }, 5000);
          const name = (info && info.name) || "工作软件";
          const scene =
            (info && info.scene) ||
            ("用户刚切换到了 " + name + "，开始干活");
          const prompt =
            scene +
            "。用符合你人设的方式给一句短吐槽、鼓励或陪伴，严禁长篇大论，30字以内。";
          speak(prompt, [
            name + "时间到，我在旁边看着。",
            "又开工了？行，我陪着。",
            "嗯，专心点，别驼背。",
            "噼里啪啦之前，先喝口水。"
          ]);
        } catch (_) {}
      };

      /* Python → 打字活动（无键值，仅频率） */
      window.__onTypingPulse = function (active) {
        try {
          store = loadStore();
          if (!store.typingAwareEnabled) {
            pet.classList.remove("typing");
            workingVisualActive = false;
            return;
          }
          pet.classList.toggle("typing", !!active);
          if (store.appearanceMode !== "gif") return;
          if (active) {
            workingVisualActive = true;
            clearTimeout(workingIdleTimer);
            if (!pet.classList.contains("talking") && petVisualState !== "clicked") {
              setPetState("working", { restart: false });
            }
          } else {
            clearTimeout(workingIdleTimer);
            workingIdleTimer = setTimeout(function () {
              workingVisualActive = false;
              resolveVisualAfterTemp();
            }, 5000);
          }
        } catch (_) {}
      };

      window.__onTypingEncourage = function () {
        try {
          store = loadStore();
          if (!store.typingAwareEnabled) return;
          if (state === BITING || state === THROWING) return;
          speak(
            "用户已经连续噼里啪啦敲键盘很久了。用符合人设的方式鼓励或吐槽一句，严禁长篇大论，30字以内。",
            [
              "噼里啪啦敲得好起劲~",
              "键盘都要冒烟了吧。",
              "敲得真欢，手腕记得歇一下。",
              "字打得飞起，我在给你加油。"
            ]
          );
        } catch (_) {}
      };
      setInterval(reportHitRect, 200);
      window.addEventListener("resize", reportHitRect);

      /* 悬停「盯——」 */
      pet.addEventListener("mouseenter", function () {
        if (state !== IDLE) return;
        if (bubble.classList.contains("show") && !bubble.classList.contains("hover-tip")) return;
        hoverLocked = true;
        showBubble("盯——", { hover: true, favoritable: false, duration: 0 });
        tryLive2DMotion(["Idle", "idle", "Flick", "Tap"]);
      });
      pet.addEventListener("mouseleave", function () {
        hoverLocked = false;
        if (bubble.classList.contains("hover-tip")) hideBubble();
      });

      pet.addEventListener("pointerdown", function (e) {
        if (state === THROWING) return;
        if (e.button === 2) return;
        if (isUiChromeTarget(e.target)) return;
        e.preventDefault();
        pet.setPointerCapture(e.pointerId);
        markActivity();
        if (pet.classList.contains("live2d-mode")) {
          playRandomLive2DMotion();
        } else {
          /* 点击 / 抓取：自定义动图模式切换 clicked */
          triggerClickedVisual();
        }
        tryLive2DMotion(["Tap", "tap", "Flick"]);

        if (state === BITING) {
          playMeow();
          registerBiteClick();
          return;
        }

        dragging = true;
        dragMoved = false;
        pet.classList.add("dragging");
        pet.classList.remove("floating");
        const c = getCenter();
        startX = e.clientX;
        startY = e.clientY;
        originX = c.x;
        originY = c.y;
        placeAt(c.x, c.y, false);
      });

      pet.addEventListener("pointermove", function (e) {
        if (state === BITING) return;
        if (!dragging || state !== IDLE) return;
        if (Math.hypot(e.clientX - startX, e.clientY - startY) > 6) dragMoved = true;
        placeAt(originX + (e.clientX - startX), originY + (e.clientY - startY), false);
      });

      function endPointer(e) {
        if (state === IDLE && dragging) {
          if (!dragMoved) enterBite(e.clientX, e.clientY);
          else {
            pet.classList.remove("dragging");
            pet.classList.add("floating");
            hideBubble();
          }
        }
        dragging = false;
        dragMoved = false;
        try { pet.releasePointerCapture(e.pointerId); } catch (_) {}
      }

      pet.addEventListener("pointerup", endPointer);
      pet.addEventListener("pointercancel", endPointer);

      window.addEventListener("pointermove", function (e) {
        if (state !== BITING) return;
        placeAt(e.clientX, e.clientY, true);
        updateShakeFromSpeed(e.clientX, e.clientY);
      });

      window.addEventListener("pointerdown", function (e) {
        if (state !== BITING) return;
        if (pet.contains(e.target)) return;
        registerBiteClick();
        markActivity();
      });

      /* Esc：设置子窗口关闭面板；猫窗 Esc 由 Python 处理退出 */
      window.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && IS_SETTINGS_WINDOW) {
          e.preventDefault();
          e.stopPropagation();
          closeSettings();
        }
      });

      let introFinished = false;

      function getIntroGreeting() {
        const h = new Date().getHours();
        if (h >= 5 && h < 11) return pickFrom(["早啊，我蹦出来啦~", "早上好，落地啦。", "呼，晨间报到~"]);
        if (h >= 11 && h < 14) return pickFrom(["午饭前，我来啦~", "中午好，蹦——", "呼，我来啦~"]);
        if (h >= 14 && h < 18) return pickFrom(["下午好，我跳过来了~", "呼，我来啦~", "下午也要眨眼哦。"]);
        if (h >= 18 && h < 23) return pickFrom(["晚上好，我蹦过来了~", "呼，我来啦~", "夜色不错，我到了。"]);
        return pickFrom(["这么晚还在呀……我来陪你。", "深夜了，轻点跳，我到了。", "呼……我来啦，别熬太狠。"]);
      }

      function finishIntroEntrance() {
        if (introFinished) return;
        introFinished = true;
        pet.classList.remove("entering", "pre-enter");
        if (state === IDLE) pet.classList.add("floating");
        setTimeout(function () {
          if (state !== IDLE) return;
          showBubble(getIntroGreeting(), { favoritable: true, voice: true });
        }, 260);
      }

      function playIntroEntrance() {
        store = loadStore();
        pet.classList.remove("floating", "entering");
        if (store.introBounceEnabled === false) {
          pet.classList.remove("pre-enter");
          pet.classList.add("floating");
          return;
        }
        /* 强制回流后再开启动画，确保从底部起跳 */
        pet.classList.add("pre-enter");
        void pet.offsetWidth;
        pet.classList.remove("pre-enter");
        pet.classList.add("entering");

        function onEnd(e) {
          if (e.target !== pet) return;
          if (e.animationName !== "petPopIn") return;
          pet.removeEventListener("animationend", onEnd);
          finishIntroEntrance();
        }
        pet.addEventListener("animationend", onEnd);
        /* 兜底：个别环境 animationend 丢失 */
        setTimeout(function () {
          if (pet.classList.contains("entering")) finishIntroEntrance();
        }, 900);
      }

      fillSettingsForm();
      applyAudioSettings();

      let lastPeerMode = "";
      let lastPeerPath = "";
      let lastPeerSizeMul = null;
      let peerSyncReady = false;

      window.__reloadSettingsFromPeer = function () {
        try {
          store = loadStore();
          const mode = store.appearanceMode || "classic";
          const path = sanitizeLive2dPath(store.live2dPath);
          const sizeMul = clampLive2dSizeMul(store.live2dSizeMul);

          if (IS_SETTINGS_WINDOW) {
            lastPeerMode = mode;
            lastPeerPath = path;
            lastPeerSizeMul = sizeMul;
            peerSyncReady = true;
            return;
          }

          syncAllToBridge(store);
          applyAudioSettings();

          if (!peerSyncReady) {
            lastPeerMode = mode;
            lastPeerPath = path;
            lastPeerSizeMul = sizeMul;
            peerSyncReady = true;
            applyAppearanceMode();
            return;
          }

          if (mode !== lastPeerMode || path !== lastPeerPath) {
            lastPeerMode = mode;
            lastPeerPath = path;
            lastPeerSizeMul = sizeMul;
            applyAppearanceMode();
            return;
          }

          if (sizeMul !== lastPeerSizeMul) {
            lastPeerSizeMul = sizeMul;
            applyLive2dSizeMul(sizeMul);
          }
        } catch (_) {}
      };

      window.addEventListener("storage", function (e) {
        if (e.key === STORAGE_KEY) {
          window.__reloadSettingsFromPeer();
        }
      });

      window.setPetState = setPetState;

      if (IS_SETTINGS_WINDOW) {
        /* 独立设置窗：只跑设置 UI，不启动猫动画 */
        return;
      }

      /* 先标记同步状态，避免首轮 storage 误判为「需重载」 */
      store = loadStore();
      lastPeerMode = store.appearanceMode || "classic";
      lastPeerPath = sanitizeLive2dPath(store.live2dPath);
      lastPeerSizeMul = clampLive2dSizeMul(store.live2dSizeMul);
      peerSyncReady = true;

      applyAppearanceMode().then(function () {
        playIntroEntrance();
      }).catch(function () {
        playIntroEntrance();
      });
      window.addEventListener("resize", function () {
        if (live2dModel && live2dApp) layoutLive2D();
        positionBubble();
        reportHitRect();
      });
    })();
  </script>
</body>
